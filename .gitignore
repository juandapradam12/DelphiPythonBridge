*.bpl
*.bpi
*.lib
*.a
*.o
*.ocx
*.tlb
*.rsm
*.tds
*.map
*.drc
*.obj
*.hpp
*.bak
*.~*
*.cfg
*.dof
*.ddp
*.opt
*.plg
*.aps
*.rsj
*.pdb
*.pch
*.idb
*.ilk
*.sbr
*.exp
*.ncb
*.suo
*.user
*.sdf
*.opensdf

# Delphi IDE local state
*.dproj.local
*.groupproj.local
*.identcache
*.dsk
*.tvsconfig
*.otares
*.local
*.deployproj.local

# Delphi output directories and editor backups
Win32/
Win64/
OSX32/
OSX64/
Linux64/
Android/
iOS32/
iOS64/
IOSARM64/
__history/
__recovery/
*.#*

# Keep the VCL project resource file (icon / version info)
!app_delphi/DelphiApp.res

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.Python
build/
dist/
eggs/
.eggs/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/

# Virtual environments and secrets
.env
.env.*
!.env.example
.venv/
venv/
ENV/
env/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Logs / temp
*.log
*.tmp
*.temp
*.cache

# OS
Thumbs.db
Desktop.ini
.DS_Store
.directory
